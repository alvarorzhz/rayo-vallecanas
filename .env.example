# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (enlaces de invitación y logo en los emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Rayo Vallecañas <loteria@tudominio.es>"
RESEND_REPLY_TO=

# --- WhatsApp Business Platform (Cloud API) ---
# Si se dejan vacías, la app ofrece "Abrir en WhatsApp" con el mensaje ya escrito.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=justificante_loteria
WHATSAPP_TEMPLATE_LANG=es
WHATSAPP_API_VERSION=v21.0

# --- IA para La Voz del Rayo (Gemini, plan gratis de Google AI Studio) ---
# Clave en https://aistudio.google.com/apikey. Sin ella, el editor solo ofrece copiar las instrucciones.
GEMINI_API_KEY=
# Opcional: fijar otro modelo si Google cambia los nombres (por defecto gemini-flash-latest)
GEMINI_MODEL=
